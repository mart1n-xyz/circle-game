{
  "name": "circle-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test app/tests/engine.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" vite.config.ts playwright.config.ts",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
